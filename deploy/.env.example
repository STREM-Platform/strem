# STREM local infrastructure — environment template.
# Copy to .env and adjust if needed. All values below are safe local defaults.
# Never put production secrets in this file.

# --- PostgreSQL (shared local instance; one database per service) ---
POSTGRES_USER=strem
POSTGRES_PASSWORD=strem
POSTGRES_DB=strem
# Each service gets its own database (strem_auth, strem_user, strem_training,
# strem_ai); docker-compose.yml builds the connection strings.

# --- Auth ---
# Local-only placeholder. Services that verify JWTs share this secret locally.
JWT_SECRET=change-me-in-local-only
# JWT signing algorithm, shared across services.
JWT_ALGORITHM=HS256

# --- AI race team (services/ai) ---
# No key (or no credit) → the deterministic race engine builds everything and the
# app says the AI is offline. Pick a provider:
#   AI_PROVIDER=anthropic | openai | empty = whichever key is set (Anthropic first)
AI_PROVIDER=
ANTHROPIC_API_KEY=
RACE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# gpt-6-astra (strongest) · gpt-6.1-sol (balanced, default) · gpt-6-luna (cheapest)
OPENAI_MODEL=gpt-6.1-sol

# --- Connected sources (services/training) ---
# Fernet key that encrypts provider OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty → connecting a source is refused (a token is never stored in plaintext).
INTEGRATIONS_ENCRYPTION_KEY=
# Whoop OAuth app (https://developer.whoop.com). Empty → Whoop can't be connected.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
# Strava OAuth app (https://www.strava.com/settings/api). Empty → Strava can't be connected.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
