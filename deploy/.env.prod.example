# STREM production settings: copy to /srv/strem/.env on the server (never commit it).
# `deploy/scripts/server-setup.sh` creates that file with the generated secrets
# filled in; add the domain and provider keys by hand.

# --- Where it runs ---
# The API's public name (DNS A record → the server's IP). Caddy gets its certificate.
API_DOMAIN=api.strem.example.com
# The web app's origin (Vercel); the only browser origin allowed to call the API.
WEB_ORIGIN=https://strem.example.com

# --- Generated once by server-setup.sh ---
POSTGRES_USER=strem
POSTGRES_PASSWORD=
POSTGRES_DB=strem
JWT_SECRET=
INTEGRATIONS_ENCRYPTION_KEY=

# --- AI race team ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
# Model calls per athlete per UTC day; past it the race engine carries on.
AI_DAILY_LIMIT=60

# --- Strava (#23) ---
# strava.com/settings/api → "Authorization Callback Domain" = the web app's host
# (strem.example.com): on web the app receives the code at WEB_ORIGIN/integrations.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://strem.example.com/integrations
