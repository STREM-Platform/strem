# strem-ai-orchestrator — local environment template.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the AI database (race chat, briefs, proposals).
DATABASE_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_ai

# Shared secret used to verify access tokens issued by strem-auth-service.
JWT_SECRET=change-me-in-local-only

# JWT signing algorithm (must match strem-auth-service).
JWT_ALGORITHM=HS256

# The service APIs the race team reads context from and writes plans/layers to
# (it copies no raw logs — context is fetched per request with the athlete token).
USER_SERVICE_BASE_URL=http://localhost:8002/v1
TRAINING_SERVICE_BASE_URL=http://localhost:8003/v1

# ── AI race team (strem-docs#26) ────────────────────────────────────────────
# Anthropic (Claude) API key. Leave blank locally/CI: the deterministic race
# engine builds every layer and the app says the AI is offline.
ANTHROPIC_API_KEY=
RACE_MODEL=claude-opus-5-5
# anthropic | openai | empty = whichever key is set (Anthropic first)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional CA bundle for outbound enrichment calls behind TLS inspection.
# SSL_CERT_FILE=
