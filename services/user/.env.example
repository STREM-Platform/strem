# strem-user-service — local environment template.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the user database (profiles, onboarding, Race OS).
DATABASE_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_user

# Secret used to verify JWT access tokens issued by strem-auth-service.
# Must match strem-auth-service's JWT_SECRET so issued tokens validate here.
JWT_SECRET=change-me-in-local-only

# JWT signing algorithm (must match strem-auth-service).
JWT_ALGORITHM=HS256

# Internal training-service ROOT (no /v1); empty disables first course attachment.
# Required for export/deletion once an account has attached a course.
COURSE_STORAGE_BASE_URL=
