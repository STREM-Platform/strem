# STREM local infrastructure — environment template.
# Copy to .env and adjust if needed. All values below are safe local defaults.
# Never put production secrets in this file.

# --- PostgreSQL (shared local instance; one database per service) ---
POSTGRES_USER=strem
POSTGRES_PASSWORD=strem
POSTGRES_DB=strem

# Per-service connection strings (_DB_URL pattern). Each points at that
# service's own database in the shared local Postgres.
AUTH_DB_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_auth
USER_DB_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_user
TRAINING_DB_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_training
NUTRITION_DB_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_nutrition
COMMUNITY_DB_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_community
AI_DB_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_ai

# --- Redis (cache + rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Message broker (Redis Streams, reusing the Redis instance above) ---
MESSAGE_BROKER_URL=redis://localhost:6379/0

# --- Auth ---
# Local-only placeholder. Services that verify JWTs share this secret locally.
JWT_SECRET=change-me-in-local-only
# JWT signing algorithm, shared across services.
JWT_ALGORITHM=HS256

# --- Forge agent (strem-ai-orchestrator) ---
# Empty key → the orchestrator uses a deterministic offline fallback: the stack
# still boots and coaches, just without live Claude. Set for real agent replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Optional LangSmith tracing (per-run agent observability). Empty → tracing off.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=strem-forge

# --- Connected-source ingestion (strem-training-service, A3) ---
# Fernet key that encrypts provider OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty → connecting a source is refused (a token is never stored in plaintext).
INTEGRATIONS_ENCRYPTION_KEY=
# Whoop OAuth app (https://developer.whoop.com). Empty → Whoop can't be connected.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
# Strava OAuth app (https://www.strava.com/settings/api). Empty → Strava can't be connected.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
