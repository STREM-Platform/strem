# strem-ai-orchestrator — local environment template.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the AI database (missions, recaps, metadata).
DATABASE_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_ai

# Shared secret used to verify access tokens issued by strem-auth-service.
JWT_SECRET=change-me-in-local-only

# JWT signing algorithm (must match strem-auth-service).
JWT_ALGORITHM=HS256

# Redis Streams broker for publishing ai.mission_generated / ai.mission_completed
# / ai.coach_summary_created.
MESSAGE_BROKER_URL=redis://localhost:6379/0

# Approved service APIs the orchestrator reads identity + behaviour context from
# (it copies no raw logs — context is fetched per request).
USER_SERVICE_BASE_URL=http://localhost:8002/v1
TRAINING_SERVICE_BASE_URL=http://localhost:8003/v1
NUTRITION_SERVICE_BASE_URL=http://localhost:8004/v1
COMMUNITY_SERVICE_BASE_URL=http://localhost:8005/v1

# ── Forge agent (B1) ─────────────────────────────────────────────────────────
# Anthropic (Claude) API key for the omniscient coach. LEAVE BLANK locally/CI to
# use the deterministic offline model (chat still works, just canned). Set it in
# staging/prod. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Latest Claude model id (do not pin to an old one).
ANTHROPIC_MODEL=claude-opus-4-8

# LangSmith — full per-run agent tracing for production inspection. Blank = off.
# Get a key at https://smith.langchain.com/ (Settings → API Keys).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=strem-forge
