# strem-training-service — local environment template.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the training database (session logs).
DATABASE_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_training

# Shared secret used to verify access tokens issued by strem-auth-service.
JWT_SECRET=change-me-in-local-only

# JWT signing algorithm (must match strem-auth-service).
JWT_ALGORITHM=HS256

# Redis Streams broker for publishing training.session_logged events.
MESSAGE_BROKER_URL=redis://localhost:6379/0

# Base URL of strem-user-service — used to read the athlete-baseline PRs (#61)
# that seed PR detection (so an early logged lift below a known PR isn't a false
# PR). In the compose stack, point this at the gateway/user-service.
USER_SERVICE_BASE_URL=http://localhost:8002/v1

# ── Connected-source ingestion (A3) ──────────────────────────────────────────
# Fernet key used to encrypt provider OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty → connecting a source is refused (tokens are never stored in plaintext).
INTEGRATIONS_ENCRYPTION_KEY=

# Whoop OAuth app (https://developer.whoop.com). Empty → Whoop can't be connected.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=

# Strava OAuth app (https://www.strava.com/settings/api). Empty → Strava can't be connected.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
