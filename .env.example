# strem-api-gateway — local environment template.
# Copy to .env and adjust. Never commit .env. No secrets live here — the gateway
# owns no data and forwards the caller's bearer token to upstream services.

# Upstream service base URLs (each already includes the /v1 base path).
AUTH_BASE_URL=http://localhost:8001/v1
USER_BASE_URL=http://localhost:8002/v1
TRAINING_BASE_URL=http://localhost:8003/v1
NUTRITION_BASE_URL=http://localhost:8004/v1
COMMUNITY_BASE_URL=http://localhost:8005/v1
AI_BASE_URL=http://localhost:8006/v1

# Per-request upstream timeout, in seconds.
UPSTREAM_TIMEOUT_SECONDS=10
