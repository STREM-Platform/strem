# strem-api-gateway — local environment template.
# Copy to .env and adjust. Never commit .env. No secrets live here — the gateway
# owns no data and forwards the caller's bearer token to upstream services.

# Upstream service base URLs (each already includes the /v1 base path).
AUTH_BASE_URL=http://localhost:8001/v1
USER_BASE_URL=http://localhost:8002/v1
TRAINING_BASE_URL=http://localhost:8003/v1
NUTRITION_BASE_URL=http://localhost:8004/v1
COMMUNITY_BASE_URL=http://localhost:8005/v1
AI_BASE_URL=http://localhost:8006/v1

# Per-request upstream timeout, in seconds.
UPSTREAM_TIMEOUT_SECONDS=180

# CORS — lets the Expo web build (a browser origin) reach the gateway. The regex
# default matches any localhost port, so the local demo works whichever port the
# Expo/Metro dev server lands on. Set CORS_ALLOW_ORIGINS (comma-separated) for
# non-local origins; lock down the regex for deploys.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=http://localhost:\d+

# Rate limiting + request-size cap (edge hardening). REDIS_URL shares counters
# across gateway instances; leave empty to use a per-process in-memory limiter.
# Limits apply per window, per client IP and per bearer token.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1048576
