# strem-auth-service — local environment template.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the auth database (sessions, tokens, identity).
DATABASE_URL=postgresql+asyncpg://strem:strem@localhost:5432/strem_auth

# Secret used to sign JWT access tokens. Use a long random value in real environments.
JWT_SECRET=change-me-in-local-only

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (contract: 15-minute short-lived access token).
ACCESS_TOKEN_EXPIRE_MINUTES=15
